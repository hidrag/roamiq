# ==============================================================================
# RoamIQ (.gitignore)
# Vite + React + TypeScript + Supabase + Leaflet Project Environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# Package manager lockfile fallbacks (uncomment if you want to enforce one lockfile)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ------------------------------------------------------------------------------
# 2. Production & Build Outputs
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
*.local
graft/

# TypeScript incremental build cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. Environment Secrets & API Keys (CRITICAL)
# ------------------------------------------------------------------------------
# Do NOT commit local keys (Gemini, Supabase, etc.)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow example template to be tracked
!.env.example

# ------------------------------------------------------------------------------
# 4. Logs, Debugging & Performance Profiling
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Editor, IDE & OS Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
graft/
